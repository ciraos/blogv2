# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next.zip
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# .env*
# 个人配置（含真实域名）不入库；如需提交模板用 .env.example
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

package-lock.json

# 本地开发验证/探测脚本（不进版本库：里面还有 anheyu 后端源码快照，几百 MB 级）
# 例外：以下脚本是**发布/CI 链路**的一部分，必须进版本库，否则 GitHub Actions 上找不到文件会直接失败
#   - package-theme.mjs      theme-package.yml 调用（打 SSR 主题包）
#   - gen-api-inventory.mjs  checks.yml 调用（pnpm api:inventory:check）
/scripts/*
!/scripts/package-theme.mjs
!/scripts/gen-api-inventory.mjs

# 本地文档（接口清单 / 实测记录，不进版本库）
/docs/

# 本地提交说明草稿（不进版本库）
commit-msg.txt

# 单元测试（本地跑 pnpm test，不进版本库）
/tests/
/dist/
