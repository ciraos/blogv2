# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next.zip
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# .env*
# 个人配置（含真实域名）不入库；如需提交模板用 .env.example
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

package-lock.json

# 本地开发验证/探测脚本（不进版本库：里面还有 anheyu 后端源码快照，几百 MB 级；
# 根目录还堆着 300 多个一次性探测脚本，逐个放行会污染历史）
# 约定：**需要进版本库、被 CI / package.json 调用的脚本一律放 `scripts/ci/`**，
# 该目录整体放行；此目录之外一律忽略，新增 CI 脚本不用再改这里。
/scripts/*
!/scripts/ci/

# 本地文档（接口清单 / 实测记录，不进版本库）
/docs/

# 本地提交说明草稿（不进版本库）
commit-msg.txt

# 单元测试（本地跑 pnpm test，不进版本库）
/tests/
/dist/
